# CODEOWNERS — code review routing
#
# Two-tier policy:
#   - infra files (Cue schemas, naming policy, build tools, CI workflows,
#     Stage 2 lock) require dev-pair review
#   - profiles/*.cue can be reviewed by any maintainer (including researchers)
#
# Update @kaitakuai/maintainers and @kaitakuai/infra teams in github org settings.

# Default — any change requires at least one maintainer review
*                              @kaitakuai/maintainers

# Infrastructure: dev-pair review required
/cue.mod/                      @kaitakuai/infra
/tools/                        @kaitakuai/infra
/profiles/schema.cue           @kaitakuai/infra
/profiles/bases/               @kaitakuai/infra
/state/schema.cue              @kaitakuai/infra
/stage2/                       @kaitakuai/infra
/stage3/Dockerfile             @kaitakuai/infra
/stage3/docker-bake.hcl        @kaitakuai/infra
/mlnode_foundry/               @kaitakuai/infra
/.github/workflows/            @kaitakuai/infra
/pyproject.toml                @kaitakuai/infra
/mise.toml                     @kaitakuai/infra
/renovate.json                 @kaitakuai/infra
/CODEOWNERS                    @kaitakuai/infra
/docs/adr/                     @kaitakuai/infra
/patches/                      @kaitakuai/infra

# Profile content — any maintainer
/profiles/*.cue                @kaitakuai/maintainers

# State — write-only by automation; manual edits require infra review
/state/*.json                  @kaitakuai/infra

# syntax=docker/dockerfile:1.7
#
# Stage 4 Dockerfile TEMPLATE — rendered per profile by
# `mlnode-foundry render-dockerfile <profile>` into `stage4/Dockerfile.rendered`.
#
# Inputs (passed via --build-arg):
#   BASE_IMAGE        — Stage 3 image (mlnode-base@sha256:...) or upstream binary
#   GPU, MODEL,
#   MODEL_REVISION,
#   QUANT             — identity axes (OCI labels)
#   PACKAGE_NAME, TAG — for labels (actual --tag is set by CLI)
#   PROFILE_HASH      — content hash of profile + naming + bases + this template
#   RUNNER_PATCH      — basename of tools/runner-patches/<x>.py (empty = no-op)
#
# Profile-specific content baked at render time (no opt-in build-args):
#   - hw-patches fragments INLINED below at the hw-patches block
#     (per profile.hw_patches, in declared order)
#   - ENV K=V for each profile.env entry (rendered ENV directive below)
#   - gonka.kaitaku.tuning_notes label (compact JSON, rendered LABEL line below)

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Identity (OCI labels)
ARG GPU
ARG MODEL
ARG MODEL_REVISION
ARG QUANT
ARG PACKAGE_NAME
ARG TAG
ARG PROFILE_HASH

# Apply hw-patches ------------------------------------------------------------
# Fragments below are inlined by render_dockerfile.py from tools/hw-patches/<name>.dockerfile
# for each name in profile.hw_patches, in declared order. Each fragment is
# idempotent and self-contained (uses RUN python3 <<'EOF' ... EOF style).
{{HW_PATCHES_BLOCK}}

# Apply runner-patch ----------------------------------------------------------
COPY --link tools/runner-patches /tmp/runner-patches
ARG RUNNER_PATCH=""
RUN if [ -n "${RUNNER_PATCH}" ]; then \
        if [ ! -f "/tmp/runner-patches/${RUNNER_PATCH}.py" ]; then \
            echo "ERROR: RUNNER_PATCH=${RUNNER_PATCH} set but /tmp/runner-patches/${RUNNER_PATCH}.py is missing" >&2; \
            exit 1; \
        fi; \
        echo "Applying runner-patch: ${RUNNER_PATCH}" && \
        python3 "/tmp/runner-patches/${RUNNER_PATCH}.py"; \
    else \
        echo "No runner-patch requested (RUNNER_PATCH unset)"; \
    fi && \
    rm -rf /tmp/runner-patches

# ENV from profile.env (rendered) ---------------------------------------------
{{ENV_BLOCK}}

LABEL gonka.kaitaku.stage="4" \
      gonka.kaitaku.gpu="${GPU}" \
      gonka.kaitaku.model="${MODEL}" \
      gonka.kaitaku.model_revision="${MODEL_REVISION}" \
      gonka.kaitaku.quant="${QUANT}" \
      gonka.kaitaku.package="${PACKAGE_NAME}" \
      gonka.kaitaku.tag="${TAG}" \
      gonka.kaitaku.profile_hash="${PROFILE_HASH}" \
      {{TUNING_LABEL}} \
      org.opencontainers.image.source="https://github.com/kaitakuai/mlnode-foundry" \
      org.opencontainers.image.licenses="Apache-2.0"
